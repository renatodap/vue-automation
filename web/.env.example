# Home Assistant, reachable from the SERVER (not the browser).
# Over Tailscale this is the Pi's tailnet name or 100.x address — never
# 10.0.0.67, which only exists inside the apartment.
HA_BASE_URL=http://vue-pi:8123

# Long-lived access token: HA → your profile → Security → Long-lived access
# tokens → Create token. Shown once. Full control of the instance.
HA_TOKEN=

# Shared passphrase gating the app. There is one user and no accounts.
APP_PASSPHRASE=

# Signs the session cookie. Rotating it logs every device out.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional for light controls; required for permanent history collection.
# Scene labels, accents, tap history and historical observations only.
DATABASE_URL=

# Shared with the standalone connector; also guards the optional scheduled sync.
MCP_INTERNAL_SECRET=

# Optional: HA's discovered timezone is the default for historical patterns.
# HISTORY_TIME_ZONE=America/New_York
# Explicit sensor room assignments override HA areas; never infer from readings.
# HISTORY_CLIMATE_ROOMS={"sensor.living_temperature":"living"}

# Production start command for live history + three-minute reconciliation:
# npm run start:history (Node >=22). See docs/history-audit.md.

# Set only when mounted under a path prefix (renatodap.me/vue-automation).
# Remove once the app owns a domain.
NEXT_BASE_PATH=/vue-automation
