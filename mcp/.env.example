# Living-room lights — MCP connector env

# --- The app this connector drives -------------------------------------------
# Every read and write about the house goes through the Next app's
# /api/internal routes, so the entity projections and the partial-application
# rule have exactly one implementation. MCP_INTERNAL_SECRET must be the SAME
# value on BOTH apps (set it on vue-automation as well, or every call 401s).
APP_INTERNAL_URL=https://renatodap.me/vue-automation
MCP_INTERNAL_SECRET=change-me

# --- The connector's own state ------------------------------------------------
# OAuth state, the audit trail and pending change proposals. The SAME shared
# Postgres the app uses (database vue_automation) — on Coolify use the same
# value as the vue-automation app's DATABASE_URL, i.e. the internal container
# host, no TLS. registry.json records no database for this service, so
# `infra db *` must never target it.
DATABASE_URL=postgresql://vue_automation:PASSWORD@HOST:5432/vue_automation

# The passphrase that gates the OAuth consent screen. Falls back to
# APP_PASSPHRASE when unset, so the two can be the same by omission.
MCP_PASSPHRASE=change-me

# --- Zigbee, one layer below Home Assistant -----------------------------------
# Mosquitto on the Pi, over the tailnet. Needed only by list_zigbee_devices,
# start_pairing, poll_pairing and name_device; everything else works without it.
MQTT_URL=mqtt://100.85.128.101:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Only if Zigbee2MQTT's base topic was changed from the default.
# Z2M_BASE_TOPIC=zigbee2mqtt

# --- Home Assistant, for ONE call --------------------------------------------
# Renaming an entity means writing the entity registry, and the registry is
# WebSocket-only — there is no REST equivalent, so it cannot go through the app.
# Optional: without these, name_device still renames in Zigbee2MQTT and reports
# plainly that the Home Assistant entity was left alone. The token must be an
# ADMIN one; a non-admin token is refused by the registry.
# Port 80, not 8123 — that is what answers over the tailnet.
HA_BASE_URL=http://100.85.128.101
HA_TOKEN=

PORT=3000
