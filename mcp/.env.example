# Living-room lights — MCP connector env

# --- The app this connector drives -------------------------------------------
# Every read and write about the house goes through the Next app's
# /api/internal routes, so the entity projections and the partial-application
# rule have exactly one implementation. MCP_INTERNAL_SECRET must be the SAME
# value on BOTH apps (set it on vue-automation as well, or every call 401s).
APP_INTERNAL_URL=https://renatodap.me/vue-automation
MCP_INTERNAL_SECRET=change-me

# --- The connector's own state ------------------------------------------------
# OAuth state, the audit trail and pending change proposals. The SAME shared
# Postgres the app uses (database vue_automation) — on Coolify use the same
# value as the vue-automation app's DATABASE_URL, i.e. the internal container
# host, no TLS. registry.json records no database for this service, so
# `infra db *` must never target it.
DATABASE_URL=postgresql://vue_automation:PASSWORD@HOST:5432/vue_automation

# The passphrase that gates the OAuth consent screen. Falls back to
# APP_PASSPHRASE when unset, so the two can be the same by omission.
MCP_PASSPHRASE=change-me

# --- Home Assistant: the path to the lights AND to the Zigbee mesh ------------
# REQUIRED by list_zigbee_devices, start_pairing, poll_pairing and name_device.
# Everything else (scenes, lamps, schedules) goes through the app and does not
# need these.
#
# Three things live only here, and none of them has an alternative:
#   • The entity and device registries are WebSocket-only commands — there is no
#     REST equivalent — so they cannot go through the Next app.
#   • The DEVICE registry is how the Zigbee mesh is discovered: every joined
#     device has a row, with its IEEE address in `identifiers` and its
#     Zigbee2MQTT friendly name in `name`.
#   • `mqtt.publish` is how a Zigbee2MQTT bridge request reaches the broker at
#     all. Home Assistant is already authenticated to Mosquitto; this connector
#     cannot be (see MQTT_URL below).
#
# The token must be an ADMIN one — the registries refuse a non-admin token even
# though it can read states. Port 80, not 8123: that is what answers over the
# tailnet.
HA_BASE_URL=http://100.85.128.101
HA_TOKEN=

# --- Mosquitto: OPTIONAL ENRICHMENT, and expected to be unavailable -----------
# The broker on the Pi requires credentials this service cannot obtain. They are
# held in the Mosquitto / Zigbee2MQTT add-on configuration behind Home
# Assistant's Supervisor; `/api/hassio/*` refuses a long-lived token with HTTP
# 401 (verified with an admin token), and Home Assistant never exposes a config
# entry's `data` over any API. There is no path from a token to that password.
#
# So leave this unset unless a broker username/password is genuinely in hand.
# When it does connect it adds three things and nothing else: live interview
# progress on poll_pairing, the z2m-only device fields (interview_completed,
# supported, power_source), and confirmation of a bridge request that was
# published through Home Assistant. When it does not connect, those come back
# null and every tool still works.
#
# A refused broker is not an error: the connector remembers the failure, logs
# one line at boot, and carries on through Home Assistant.
# MQTT_URL=mqtt://100.85.128.101:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Only if Zigbee2MQTT's base topic was changed from the default. This is used
# for the published topic whether or not a direct broker connection exists.
# Z2M_BASE_TOPIC=zigbee2mqtt

PORT=3000
