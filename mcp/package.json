{
  "name": "vue-automation-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP connector for the living-room lighting — Home Assistant scenes, lamps, schedules and Zigbee pairing.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && node --test --test-force-exit tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mqtt": "^5.10.0",
    "postgres": "^3.4.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
