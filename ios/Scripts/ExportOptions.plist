<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode 15+ spelling. The older value was `app-store`; both are accepted
	     today but only this one is documented, and a wrong value exports
	     successfully and produces an IPA App Store Connect then refuses. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>T59UJ8766W</string>

	<!-- Let Xcode fetch or create the App Store profile against the API key
	     rather than requiring one checked in. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Symbols go up so a crash report is readable. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Bitcode has been dead since Xcode 14; naming it explicitly stops a
	     future default from turning it back on. -->
	<key>compileBitcode</key>
	<false/>

	<!-- `export`, NOT `upload`.
	     `upload` makes exportArchive ship the build ITSELF and write no .ipa at
	     all. It works — the build really does reach App Store Connect — and then
	     the next line of release.sh cannot find a file to validate, so the script
	     exits non-zero having already succeeded. A green upload reported as a
	     failed release is the worst of both, and in CI it would retry an upload
	     Apple has already accepted and fail on the duplicate build number.
	     `export` writes the .ipa; altool validates and uploads it. -->
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
